# Copy to .env and fill in. Never commit .env.
# Values already set in the MCP client's "env" block take priority over this file.

# --- Required: OAuth client of type "Desktop app" from Google Cloud Console ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# --- Optional ---
# Loopback port used only by `npm run auth` (http://127.0.0.1:<port>/oauth2callback)
GOOGLE_OAUTH_REDIRECT_PORT=53682
# Where the refresh token is stored (relative paths resolve against the project root)
GOOGLE_TOKEN_PATH=./.local/google-token.json
# Per-request timeout for Google APIs (ms)
GOOGLE_API_TIMEOUT_MS=20000
# Gmail limits
GMAIL_MAX_RECIPIENTS=50
GMAIL_MAX_SUBJECT_CHARS=500
GMAIL_MAX_BODY_BYTES=1048576
# Docs limits and behaviour
DOCS_MAX_APPEND_CHARS=50000
DOCS_MAX_WRITE_ATTEMPTS=3
# IANA time zone used when insert_timestamp=true
DOCS_TIMESTAMP_TIMEZONE=UTC
# error | warn | info | debug  (logs go to stderr; never contain message content)
LOG_LEVEL=info

# --- Remote hosting only (npm run start:http, e.g. Railway). Not used by the stdio server. ---
# Port to listen on. Railway sets this itself.
# PORT=3000
# Required for start:http, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# MCP_AUTH_TOKEN=
# Comma-separated Host names allowed to call the server (no ports). RAILWAY_PUBLIC_DOMAIN is added automatically.
# MCP_ALLOWED_HOSTS=your-app.up.railway.app
# Requests per minute per client IP on /mcp
# MCP_RATE_LIMIT_PER_MINUTE=30
# Reverse proxies in front of the server. Default: 1 on Railway, 0 elsewhere.
# MCP_TRUST_PROXY=1
# Base64 of the token file made by `npm run auth`; written to GOOGLE_TOKEN_PATH only if that file is missing.
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("..localgoogle-token.json"))
# GOOGLE_TOKEN_B64=
